#!/data/data/com.termux/files/usr/bin/bash
# debian-fast on|off|status: fast mode for the Debian apps.
#
# Fast mode runs Debian through proroot (https://github.com/coderredlab/proroot) instead of proot.
# proroot avoids proot's per system call overhead and is many times faster for file heavy work,
# but it is closed source ("Proprietary. Free to use in your projects."), so it is optional and
# downloaded from its own releases, unmodified and checked against the checksums below. Turning it
# on test-runs Debian through it first and only switches when that works.
set -u
VERSION=v1.2.8
DIR="$PREFIX/libexec/proroot"
FLAG="$HOME/.termux/debian-fast"
FILES="1c5bc9537a270e8bf8b1c70222813f57b60b828bfb5503ddf8fe37685092de2f libproroot-bridge.so
51a0ec5bfed00e572a0de09e22d9057e2befc386b78e426613d3e0ab03f4ecee libproroot-linker.so
8c47a0a7db32d84c179ebb5bf3640f655a3181860ece5886ae44d92858730c34 libproroot-runtime.so
06c6624db3bdc45b9ced151cd781df439a37b47731d244b93e9d6a58cd48cde0 libproroot-stub-loader.so
a4e74d75b66cdc02b080adfe863dbf9951c3b30610d77beddc95488d5fe5de01 libproroot.so"

case "${1:-status}" in
  on)
    mkdir -p "$DIR"
    if ! (cd "$DIR" && echo "$FILES" | sha256sum -c --quiet >/dev/null 2>&1); then
      echo "Downloading proroot $VERSION"
      echo "$FILES" | while read -r _ f; do
        curl -fsSL -o "$DIR/$f" "https://github.com/coderredlab/proroot/releases/download/$VERSION/$f" || exit 1
      done || { echo "Download failed, fast mode stays off."; exit 1; }
      (cd "$DIR" && echo "$FILES" | sha256sum -c --quiet) || { echo "Checksum mismatch, fast mode stays off."; rm -rf "$DIR"; exit 1; }
      chmod 700 "$DIR"/*.so
    fi
    touch "$FLAG"
    if [ "$(debian-run true && echo ok)" = ok ] && [ "$(debian-run --root true && echo ok)" = ok ]; then
      echo "Fast mode is on. Debian apps started from now on run through proroot."
      echo "proroot is closed source by coderred: https://github.com/coderredlab/proroot"
    else
      rm -f "$FLAG"
      echo "proroot could not run Debian on this phone, fast mode stays off."
      exit 1
    fi ;;
  off) rm -f "$FLAG"; echo "Fast mode is off. Debian apps started from now on run through proot." ;;
  status) [ -e "$FLAG" ] && echo "on (proroot)" || echo "off (proot)" ;;
  *) echo "usage: debian-fast on|off|status"; exit 1 ;;
esac
