#!/data/data/com.termux/files/usr/bin/bash
# desktop-theme [dark|light]
# Plasma-like look for XFCE: Breeze GTK + icons + cursor, Noto Sans, one bottom panel
# with Whisker Menu, Docklike taskbar, system tray and clock.
set -u
MODE="${1:-dark}"
if [ "$MODE" = light ]; then GTK=Breeze; ICONS=breeze; DARK=false
else GTK=Breeze-Dark; ICONS=breeze-dark; DARK=true; fi

say() { printf '\033[1;36m==> %s\033[0m\n' "$*"; }

# ---- packages ---------------------------------------------------------------------------
need=""
for p in breeze-gtk kf6-breeze-icons xfce4-whiskermenu-plugin xfce4-docklike-plugin; do
  dpkg -s "$p" >/dev/null 2>&1 || need="$need $p"
done
if [ -n "$need" ]; then
  say "Installing:$need"
  yes | pkg install -y $need || { echo "install failed"; exit 1; }
fi

# Cursor: only the cursor folder from the "breeze" package (the full package pulls in ~70 KDE libs).
if [ ! -d "$HOME/.icons/breeze_cursors" ]; then
  say "Extracting Breeze cursors"
  tmp=$(mktemp -d "$TMPDIR/breeze.XXXX")
  ( cd "$tmp" && apt-get download breeze >/dev/null 2>&1 && dpkg-deb -x breeze_*.deb x ) &&
    # A downloaded package still has Termux's own paths inside (only installs go through the apt hook).
    mkdir -p "$HOME/.icons" && cp -r "$tmp"/x/data/data/*/files/usr/share/icons/breeze_cursors "$HOME/.icons/"
  rm -rf "$tmp"
fi
CURSOR=breeze_cursors; [ -d "$HOME/.icons/breeze_cursors" ] || CURSOR=Adwaita

# Font: Noto Sans (Plasma's default) from Google Fonts.
FONTDIR="$HOME/.local/share/fonts"
if ! ls "$FONTDIR"/NotoSans* >/dev/null 2>&1; then
  say "Downloading Noto Sans"
  mkdir -p "$FONTDIR"
  curl -fsSL -o "$FONTDIR/NotoSans.ttf" \
    'https://github.com/google/fonts/raw/main/ofl/notosans/NotoSans%5Bwdth,wght%5D.ttf' &&
    fc-cache -f "$FONTDIR" >/dev/null 2>&1
fi
FONT="Noto Sans 10"; ls "$FONTDIR"/NotoSans* >/dev/null 2>&1 || FONT="Sans 10"

# Window borders: a Breeze-like xfwm4 theme if one is installed, else the flat default.
WM=Default
for t in "$HOME/.themes/$GTK" "$PREFIX/share/themes/$GTK"; do
  [ -d "$t/xfwm4" ] && WM="$GTK"
done

# Wallpaper: Plasma 6's Scarlet Tree (axo1otl, CC-BY-SA-4.0), dark or light to match.
WALLDIR="$HOME/.local/share/wallpapers"
WALL="$WALLDIR/scarlet-tree-$MODE.png"
if [ ! -s "$WALL" ]; then
  say "Downloading wallpaper"
  v=images; [ "$MODE" = light ] || v=images_dark
  mkdir -p "$WALLDIR"
  curl -fsSL -o "$WALL"     "https://invent.kde.org/plasma/plasma-workspace-wallpapers/-/raw/master/ScarletTree/contents/$v/5120x2880.png" ||
    rm -f "$WALL"
fi

# ---- apply ------------------------------------------------------------------------------
# Talk to the running session's settings daemon.
sess=$(pgrep -x xfce4-session | head -1)
if [ -n "$sess" ]; then
  export $(tr '\0' '\n' < /proc/$sess/environ | grep -E '^(DBUS_SESSION_BUS_ADDRESS|DISPLAY)=')
fi
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || { echo "Desktop is not running, start it first."; exit 1; }
q() { xfconf-query "$@" 2>/dev/null; }

say "Theme: $GTK, icons: $ICONS, cursor: $CURSOR, font: $FONT, borders: $WM"
q -c xsettings -p /Net/ThemeName       -n -t string -s "$GTK"
q -c xsettings -p /Net/IconThemeName   -n -t string -s "$ICONS"
q -c xsettings -p /Gtk/CursorThemeName -n -t string -s "$CURSOR"
q -c xsettings -p /Gtk/FontName        -n -t string -s "$FONT"
q -c xsettings -p /Gtk/MonospaceFontName -n -t string -s "Monospace 10"
q -c xfwm4 -p /general/theme           -n -t string -s "$WM"
q -c xfwm4 -p /general/title_font      -n -t string -s "Noto Sans Bold 10"
q -c xfwm4 -p /general/button_layout   -n -t string -s "O|HMC"
q -c xfce4-desktop -p /desktop-icons/style -n -t int -s 0      # no desktop icons, like Plasma
if [ -s "$WALL" ]; then
  # Every monitor the X server reports (Termux:X11 renames its output at runtime, "builtin" on
  # the phone's screen), plus whatever monitors xfdesktop already knows.
  for m in $(xrandr --listmonitors 2>/dev/null | awk 'NR > 1 { print "/backdrop/screen0/monitor" $NF }') \
           $(q -c xfce4-desktop -l | grep -o '^/backdrop/screen0/monitor[^/]*' | sort -u); do
    q -c xfce4-desktop -p "$m/workspace0/last-image" -n -t string -s "$WALL"
    q -c xfce4-desktop -p "$m/workspace0/image-style" -n -t int -s 5   # zoomed: fill, keep ratio
  done
fi

say "Panel layout"
q -c xfce4-panel -p /panels -r -R
q -c xfce4-panel -p /plugins -r -R
q -c xfce4-panel -p /configver -n -t int -s 2
q -c xfce4-panel -p /panels -n -a -t int -s 1
q -c xfce4-panel -p /panels/dark-mode -n -t bool -s "$DARK"
P=/panels/panel-1
q -c xfce4-panel -p $P/position        -n -t string -s "p=10;x=0;y=0"
q -c xfce4-panel -p $P/length          -n -t double -s 100
q -c xfce4-panel -p $P/position-locked -n -t bool -s true
q -c xfce4-panel -p $P/size            -n -t uint -s 56
q -c xfce4-panel -p $P/icon-size       -n -t uint -s 0
q -c xfce4-panel -p $P/plugin-ids -n -a -t int -s 1 -t int -s 2 -t int -s 3 -t int -s 4 -t int -s 5
q -c xfce4-panel -p /plugins/plugin-1 -n -t string -s whiskermenu
q -c xfce4-panel -p /plugins/plugin-2 -n -t string -s docklike
q -c xfce4-panel -p /plugins/plugin-3 -n -t string -s separator
q -c xfce4-panel -p /plugins/plugin-3/expand -n -t bool -s true
q -c xfce4-panel -p /plugins/plugin-3/style  -n -t uint -s 0
q -c xfce4-panel -p /plugins/plugin-4 -n -t string -s systray
q -c xfce4-panel -p /plugins/plugin-4/square-icons -n -t bool -s true
q -c xfce4-panel -p /plugins/plugin-5 -n -t string -s clock
q -c xfce4-panel -p /plugins/plugin-5/digital-layout -n -t uint -s 3
q -c xfce4-panel -p /plugins/plugin-5/digital-time-format -n -t string -s "%H:%M"
q -c xfce4-panel -p /plugins/plugin-5/digital-date-format -n -t string -s "%d.%m.%Y"

# Whisker Menu: Kickoff-like, with the Pocket Linux logo as the user picture.
mkdir -p "$HOME/.config/xfce4/panel"
[ -e "$HOME/.face" ] || cp "$PREFIX/share/pocket-linux/menu-icon.svg" "$HOME/.face" 2>/dev/null
cat > "$HOME/.config/xfce4/panel/whiskermenu-1.rc" <<RC
button-icon=$PREFIX/share/pocket-linux/menu-icon.svg
button-single-row=false
show-button-title=false
show-button-icon=true
launcher-show-name=true
launcher-show-description=false
position-search-alternate=true
position-commands-alternate=true
menu-width=420
menu-height=560
category-icon-size=1
item-icon-size=2
view-mode=1
favorites=xfce4-web-browser.desktop,xfce4-file-manager.desktop,xfce4-terminal-emulator.desktop,debian-synaptic.desktop
RC

# Synaptic: straight to the package list, without its introduction dialog.
mkdir -p "$HOME/.synaptic"
[ -e "$HOME/.synaptic/synaptic.conf" ] ||
  echo 'Synaptic { showWelcomeDialog "0"; };' > "$HOME/.synaptic/synaptic.conf"

xfce4-panel -r >/dev/null 2>&1 &
sleep 1
say "Done. Switch with: desktop-theme dark | desktop-theme light"
