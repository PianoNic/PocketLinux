<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Boot screen, Material 3 Expressive. On Android 12+ DynamicColors swaps these for the
         wallpaper colors. Older phones get this palette, built from the app icon. -->
    <style name="Theme.PocketLinux.Boot" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="colorPrimary">#F4B63F</item>
        <item name="colorOnPrimary">#402D00</item>
        <item name="colorPrimaryContainer">#5C4300</item>
        <item name="colorOnPrimaryContainer">#FFDEA6</item>
        <item name="colorPrimaryInverse">#7A5900</item>
        <item name="colorSecondary">#D8C4A0</item>
        <item name="colorOnSecondary">#3B2F15</item>
        <item name="colorSecondaryContainer">#53452A</item>
        <item name="colorOnSecondaryContainer">#F5E0BB</item>
        <item name="colorTertiary">#A6D0B6</item>
        <item name="colorOnTertiary">#0E3724</item>
        <item name="colorTertiaryContainer">#284E3A</item>
        <item name="colorOnTertiaryContainer">#C1ECD1</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>
        <item name="android:colorBackground">#101418</item>
        <item name="colorOnBackground">#E0E2E8</item>
        <item name="colorSurface">#101418</item>
        <item name="colorOnSurface">#E0E2E8</item>
        <item name="colorSurfaceVariant">#41484D</item>
        <item name="colorOnSurfaceVariant">#C1C7CE</item>
        <item name="colorSurfaceDim">#101418</item>
        <item name="colorSurfaceBright">#36393E</item>
        <item name="colorSurfaceContainerLowest">#0B0F12</item>
        <item name="colorSurfaceContainerLow">#181C20</item>
        <item name="colorSurfaceContainer">#1C2024</item>
        <item name="colorSurfaceContainerHigh">#262A2F</item>
        <item name="colorSurfaceContainerHighest">#31353A</item>
        <item name="colorSurfaceInverse">#E0E2E8</item>
        <item name="colorOnSurfaceInverse">#2D3135</item>
        <item name="colorOutline">#8B9198</item>
        <item name="colorOutlineVariant">#41484D</item>
        <item name="android:windowBackground">@color/pocket_icon_background</item>
        <item name="android:statusBarColor">@color/pocket_icon_background</item>
        <item name="android:navigationBarColor">@color/pocket_icon_background</item>
    </style>

    <style name="Widget.PocketLinux.Button" parent="Widget.Material3Expressive.Button">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>
    <style name="Widget.PocketLinux.Button.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>
</resources>
