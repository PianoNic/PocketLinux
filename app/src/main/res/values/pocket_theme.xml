<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Boot screen, Material 3 Expressive. One palette on every phone: Material's content scheme
         for the logo's amber #F4B63F (dark), with a warm orange #E8773A as tertiary instead of the
         scheme's lime green. Not the wallpaper colors, so the app always looks like its logo. -->
    <style name="Theme.PocketLinux.Boot" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="colorPrimary">#FFD795</item>
        <item name="colorOnPrimary">#422C00</item>
        <item name="colorPrimaryContainer">#F4B63F</item>
        <item name="colorOnPrimaryContainer">#694900</item>
        <item name="colorPrimaryInverse">#7D5700</item>
        <item name="colorSecondary">#E4C28B</item>
        <item name="colorOnSecondary">#412D03</item>
        <item name="colorSecondaryContainer">#5D451A</item>
        <item name="colorOnSecondaryContainer">#D5B47E</item>
        <item name="colorTertiary">#FFB693</item>
        <item name="colorOnTertiary">#562000</item>
        <item name="colorTertiaryContainer">#E8773A</item>
        <item name="colorOnTertiaryContainer">#541E00</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>
        <item name="android:colorBackground">#17130B</item>
        <item name="colorOnBackground">#ECE1D3</item>
        <item name="colorSurface">#17130B</item>
        <item name="colorOnSurface">#ECE1D3</item>
        <item name="colorSurfaceVariant">#504535</item>
        <item name="colorOnSurfaceVariant">#D4C4AF</item>
        <item name="colorSurfaceDim">#17130B</item>
        <item name="colorSurfaceBright">#3F382F</item>
        <item name="colorSurfaceContainerLowest">#120D07</item>
        <item name="colorSurfaceContainerLow">#201B13</item>
        <item name="colorSurfaceContainer">#241F17</item>
        <item name="colorSurfaceContainerHigh">#2F2920</item>
        <item name="colorSurfaceContainerHighest">#3A342B</item>
        <item name="colorSurfaceInverse">#ECE1D3</item>
        <item name="colorOnSurfaceInverse">#362F27</item>
        <item name="colorOutline">#9D8F7B</item>
        <item name="colorOutlineVariant">#504535</item>
        <item name="android:windowBackground">#17130B</item>
        <item name="android:statusBarColor">#17130B</item>
        <item name="android:navigationBarColor">#17130B</item>
    </style>

    <style name="Widget.PocketLinux.Button" parent="Widget.Material3Expressive.Button">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>
    <style name="Widget.PocketLinux.Button.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>
</resources>
